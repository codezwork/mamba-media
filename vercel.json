{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mambaclub.site"
        }
      ],
      "destination": "https://mambamedia.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mambaclub.site"
        }
      ],
      "destination": "https://mambamedia.in/:path*",
      "permanent": true
    }
  ]
}